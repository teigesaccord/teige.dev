---
import { SITE_TITLE } from '../consts';

const links = [
  { href: '/', label: 'Posts' },
  { href: '/tags/', label: 'Tags' },
  { href: '/about/', label: 'About' },
];

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' || path.startsWith('/blog') : path.startsWith(href);
---

<header class="site-header">
  <div class="inner">
    <a href="/" class="brand">
      <span class="dot" aria-hidden="true"></span>
      {SITE_TITLE}
    </a>

    <nav aria-label="Main">
      {
        links.map((l) => (
          <a href={l.href} class:list={['nav-link', { active: isActive(l.href) }]} aria-current={isActive(l.href) ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="controls">
      <button type="button" class="icon-btn font-btn" data-font-toggle aria-label="Change font">
        <span aria-hidden="true">Aa</span>
        <span class="font-name" data-font-name aria-hidden="true"></span>
      </button>

      <button type="button" class="icon-btn theme-btn" data-theme-toggle aria-label="Toggle dark mode">
        <svg class="sun" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="4.2"></circle>
          <g class="rays">
            <path d="M12 2.5v2.2M12 19.3v2.2M4.6 4.6l1.6 1.6M17.8 17.8l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.6 19.4l1.6-1.6M17.8 6.2l1.6-1.6"></path>
          </g>
        </svg>
        <svg class="moon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5a8.5 8.5 0 1 0 10.7 10.7Z"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid transparent;
    transition:
      border-color var(--dur) var(--ease),
      background-color var(--dur) var(--ease);
  }
  .inner {
    max-width: calc(var(--measure) + 3rem);
    margin: 0 auto;
    padding: 0.9rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .brand {
    font-weight: 650;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    white-space: nowrap;
  }
  .dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--accent);
    transition: transform 500ms var(--ease);
  }
  .brand:hover .dot {
    transform: scale(1.5);
  }

  nav {
    display: flex;
    gap: 1.1rem;
    margin-left: auto;
    font-size: 0.9rem;
  }
  .nav-link {
    position: relative;
    color: var(--muted);
    transition: color 200ms var(--ease);
    padding: 0.2rem 0;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 2px;
    border-radius: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 350ms var(--ease);
  }
  .nav-link:hover,
  .nav-link.active {
    color: var(--text);
  }
  .nav-link:hover::after,
  .nav-link.active::after {
    transform: scaleX(1);
  }

  .controls {
    display: flex;
    gap: 0.35rem;
  }
  .icon-btn {
    height: 2.2rem;
    min-width: 2.2rem;
    display: inline-grid;
    place-items: center;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text);
    border-radius: 999px;
    cursor: pointer;
    font: inherit;
    font-size: 0.85rem;
    position: relative;
    transition:
      background-color 200ms var(--ease),
      border-color 200ms var(--ease),
      transform 200ms var(--ease);
  }
  .icon-btn:hover {
    background: var(--bg-soft);
  }
  .icon-btn:active {
    transform: scale(0.92);
  }

  /* Font button: shows the font name briefly on change */
  .font-btn {
    padding: 0 0.7rem;
  }
  .font-name {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    white-space: nowrap;
    font-size: 0.75rem;
    padding: 0.25rem 0.6rem;
    border-radius: 6px;
    background: var(--text);
    color: var(--bg);
    opacity: 0;
    transform: translateY(-4px);
    pointer-events: none;
  }
  .font-btn:global(.bump) .font-name {
    animation: toast 1.6s var(--ease);
  }
  @keyframes toast {
    0% {
      opacity: 0;
      transform: translateY(-4px);
    }
    15%,
    75% {
      opacity: 1;
      transform: none;
    }
    100% {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  /* Theme button: sun rotates away, moon swings in */
  .theme-btn svg {
    grid-area: 1 / 1;
    width: 1.15rem;
    height: 1.15rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition:
      transform 600ms var(--ease),
      opacity 400ms var(--ease);
  }
  .moon {
    fill: currentColor !important;
    stroke: none !important;
    opacity: 0;
    transform: rotate(-90deg) scale(0.4);
  }
  :global([data-theme='dark']) .sun {
    opacity: 0;
    transform: rotate(90deg) scale(0.4);
  }
  :global([data-theme='dark']) .moon {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 560px) {
    .inner {
      flex-wrap: wrap;
      gap: 0.75rem;
    }
    nav {
      order: 3;
      width: 100%;
      margin-left: 0;
    }
    .controls {
      margin-left: auto;
    }
  }
</style>
