---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
  posts: CollectionEntry<'blog'>[];
  offset?: number;
}
const { posts, offset = 0 } = Astro.props;
---

<ul class="posts">
  {
    posts.map((post, i) => (
      <li class="rise" style={`--i: ${i + offset}`}>
        <a href={`/blog/${post.id}/`} class="card">
          <div class="meta">
            <FormattedDate date={post.data.pubDate} />
            {post.data.status && <span class={`status ${post.data.status}`}>{post.data.status.replace('-', ' ')}</span>}
          </div>
          <h2 transition:name={`title-${post.id}`}>{post.data.title}</h2>
          <p>{post.data.description}</p>
          <span class="read" aria-hidden="true">
            Read <span class="arrow">→</span>
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .posts {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.5rem;
  }
  .card {
    display: block;
    padding: 1.25rem 1.25rem 1.1rem;
    margin: 0 -1.25rem;
    border-radius: 14px;
    transition:
      background-color 300ms var(--ease),
      transform 300ms var(--ease);
  }
  .card:hover,
  .card:focus-visible {
    background: var(--bg-soft);
    transform: translateX(4px);
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.8rem;
    color: var(--muted);
  }
  h2 {
    font-size: 1.25rem;
    margin: 0.3rem 0 0.35rem;
  }
  p {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .read {
    display: inline-block;
    margin-top: 0.6rem;
    font-size: 0.82rem;
    color: var(--accent);
    opacity: 0;
    transform: translateX(-6px);
    transition:
      opacity 300ms var(--ease),
      transform 300ms var(--ease);
  }
  .arrow {
    display: inline-block;
    transition: transform 300ms var(--ease);
  }
  .card:hover .read,
  .card:focus-visible .read {
    opacity: 1;
    transform: none;
  }
  .card:hover .arrow {
    transform: translateX(4px);
  }
  @media (hover: none) {
    .read {
      opacity: 1;
      transform: none;
    }
  }

  .status {
    text-transform: capitalize;
    font-size: 0.72rem;
    padding: 0.05rem 0.55rem;
    border-radius: 999px;
    border: 1px solid var(--border);
  }
  .status.shipped {
    color: #3f8f5b;
    border-color: color-mix(in srgb, #3f8f5b 40%, transparent);
  }
  .status.in-progress {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
  }
</style>
