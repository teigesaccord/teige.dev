---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
}

const { title, description = SITE_DESCRIPTION, type = 'website' } = Astro.props;
const fullTitle = title ? `${title} · ${SITE_TITLE}` : SITE_TITLE;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <!-- Open Graph: controls how links look when shared on LinkedIn -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? SITE_TITLE} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta name="twitter:card" content="summary" />

    <meta name="theme-color" content="#faf8f3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#161513" media="(prefers-color-scheme: dark)" />

    <!-- Apply saved theme + font before first paint (no flash) -->
    <script is:inline>
      (() => {
        const read = (k) => {
          try {
            return localStorage.getItem(k);
          } catch {
            return null;
          }
        };
        const apply = (doc) => {
          const root = doc.documentElement;
          const saved = read('theme');
          root.dataset.theme =
            saved ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          root.dataset.font = read('font') ?? 'lexend';
          root.classList.add('js');
        };
        apply(document);
        if (!window.__prefsBound) {
          window.__prefsBound = true;
          // Client-side navigation swaps <html> attributes, so re-apply on the incoming page
          document.addEventListener('astro:before-swap', (e) => apply(e.newDocument));
        }
      })();
    </script>

    <ClientRouter />
  </head>
  <body>
    <a class="skip sr-only" href="#content">Skip to content</a>
    <Header />
    <main id="content" transition:name="main">
      <slot />
    </main>
    <Footer />

    <script>
      // ---- Theme + font toggles (event delegation survives page swaps) ----
      const FONTS = [
        { id: 'lexend', label: 'Lexend' },
        { id: 'opendyslexic', label: 'OpenDyslexic' },
        { id: 'atkinson', label: 'Atkinson Hyperlegible' },
      ];

      const save = (k: string, v: string) => {
        try {
          localStorage.setItem(k, v);
        } catch {
          /* private mode etc. */
        }
      };

      const root = document.documentElement;

      function syncLabels() {
        const theme = root.dataset.theme;
        document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((b) => {
          b.setAttribute('aria-label', `Switch to ${theme === 'dark' ? 'light' : 'dark'} mode`);
          b.setAttribute('aria-pressed', String(theme === 'dark'));
        });
        const font = FONTS.find((f) => f.id === root.dataset.font) ?? FONTS[0];
        document.querySelectorAll<HTMLButtonElement>('[data-font-toggle]').forEach((b) => {
          b.setAttribute('aria-label', `Font: ${font.label}. Click to change.`);
          b.title = `Font: ${font.label}`;
          const out = b.querySelector('[data-font-name]');
          if (out) out.textContent = font.label;
        });
      }

      function setTheme(next: string, origin?: HTMLElement) {
        const apply = () => {
          root.dataset.theme = next;
          save('theme', next);
          syncLabels();
        };
        const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!document.startViewTransition || reduce || !origin) return apply();

        // Circular reveal centred on the button
        const r = origin.getBoundingClientRect();
        const x = r.left + r.width / 2;
        const y = r.top + r.height / 2;
        const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
        root.style.setProperty('--tx', `${x}px`);
        root.style.setProperty('--ty', `${y}px`);
        root.style.setProperty('--tr', `${radius}px`);
        root.classList.add('theme-switching');
        const t = document.startViewTransition(apply);
        t.finished.finally(() => root.classList.remove('theme-switching'));
      }

      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const themeBtn = target.closest<HTMLElement>('[data-theme-toggle]');
        if (themeBtn) {
          setTheme(root.dataset.theme === 'dark' ? 'light' : 'dark', themeBtn);
          return;
        }
        const fontBtn = target.closest<HTMLElement>('[data-font-toggle]');
        if (fontBtn) {
          const i = FONTS.findIndex((f) => f.id === root.dataset.font);
          const next = FONTS[(i + 1) % FONTS.length];
          root.dataset.font = next.id;
          save('font', next.id);
          syncLabels();
          fontBtn.classList.remove('bump');
          void fontBtn.offsetWidth; // restart animation
          fontBtn.classList.add('bump');
        }
      });

      // Follow OS theme changes unless the visitor picked one explicitly
      matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
        let saved: string | null = null;
        try {
          saved = localStorage.getItem('theme');
        } catch {}
        if (!saved) {
          root.dataset.theme = e.matches ? 'dark' : 'light';
          syncLabels();
        }
      });

      // ---- Scroll reveal ----
      let observer: IntersectionObserver | undefined;
      function setupReveal() {
        observer?.disconnect();
        // In posts, blocks below the fold fade in as you scroll to them
        document
          .querySelectorAll('.prose > :is(h2, h3, p, pre, img, figure, blockquote, table, ul, ol)')
          .forEach((el) => {
            if (el.getBoundingClientRect().top > innerHeight) el.setAttribute('data-reveal', '');
          });
        observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer?.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
        );
        document.querySelectorAll('[data-reveal]').forEach((el) => observer!.observe(el));
      }

      document.addEventListener('astro:page-load', () => {
        syncLabels();
        setupReveal();
      });
    </script>
  </body>
</html>

<style>
  .skip:focus {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    width: auto;
    height: auto;
    clip: auto;
    padding: 0.5rem 0.9rem;
    background: var(--text);
    color: var(--bg);
    border-radius: 8px;
    z-index: 100;
  }
</style>
