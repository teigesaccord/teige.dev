---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { getPosts } from '../lib/posts';
import { SITE_DESCRIPTION } from '../consts';

const posts = await getPosts();
---

<Base>
  <section class="intro">
    <p class="eyebrow rise" style="--i: 0">Hobby projects, documented</p>
    <h1 class="rise" style="--i: 1">Things I've started building<span class="accent">.</span></h1>
    <p class="lede muted rise" style="--i: 2">{SITE_DESCRIPTION}</p>
  </section>

  {posts.length ? <PostList posts={posts} offset={3} /> : <p class="muted">No posts yet. Soon.</p>}
</Base>

<style>
  .intro {
    margin: 1.5rem 0 3rem;
  }
  .eyebrow {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
    margin-bottom: 0.75rem;
  }
  h1 {
    font-size: clamp(2rem, 6vw, 2.8rem);
    margin-bottom: 0.75rem;
  }
  .accent {
    color: var(--accent);
    display: inline-block;
    animation: blink 1.4s steps(1) 1s 3;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .lede {
    font-size: 1.05rem;
    max-width: 52ch;
  }
</style>
